{# Motiv pole MailBodyType — editor textu mailu; odesílané pole zůstává textarea (name = full_name). #}
{% block mail_body_widget %}
    {% include '@OswisOrgOswisCore/mail/editor.html.twig' with {
        name: full_name,
        id: id,
        value: value,
        config: editor_config,
        required: required,
        rows: rows,
        preview: preview,
        label: label|default('Text zprávy'),
    } only %}
{% endblock %}

{# Motiv pole MailSubjectType — předmět s nabídkou „Vložit údaj" (ovládá Stimulus `mail-subject`). #}
{% block mail_subject_widget %}
    {% include '@OswisOrgOswisCore/mail/subject.html.twig' with {
        input: block('form_widget_simple'),
        id: id,
        groups: variable_groups,
    } only %}
{% endblock %}
