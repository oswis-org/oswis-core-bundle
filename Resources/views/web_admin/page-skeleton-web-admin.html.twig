{% extends '@OswisOrgOswisCore/web/page-skeleton-default.html.twig' %}

{# Pojistka proti DVOJÍMU ODESLÁNÍ formuláře — jednou pro celý web-admin.

   PROČ: dvojí odeslání není teorie. 16. 8. 2026 se dvakrát zpracoval import plateb a vzniklo
   102 fiktivních plateb za 349 735 Kč (docs/OSWIS_1_INCIDENT_PAYMENT_DUPLICATES_2026-08-16.md).
   Ohrožené jsou hlavně akce, které něco ROZEŠLOU nebo VYTVOŘÍ — ad-hoc e-mail účastníkovi
   (dvojí odeslání = dva maily reálnému člověku) nebo klonování ročníku. Přesměrování po úspěchu
   chrání jen proti F5, ne proti dvojímu kliknutí; a iOS Safari umí odeslat formulář 3–5×.

   Tohle je POSLEDNÍ vrstva, ne jediná — spolehlivou pojistkou zůstává zámek na serveru
   (viz `ParticipantPaymentsImportService::processImport()`), protože JS lze obejít.

   Detaily provedení, na kterých záleží:
   - posluchač běží v bublací fázi a respektuje `defaultPrevented`, takže neposlepuje formulář,
     jehož odeslání zrušil někdo jiný (validace, potvrzovací dialog),
   - tlačítko se vypíná až v `setTimeout(…, 0)`, tedy PO serializaci — jinak by se jeho jméno
     a hodnota nemusely odeslat (rozlišování více submit tlačítek),
   - `GET` formuláře (filtry, hledání) a formuláře mířící do jiného okna se přeskakují. #}
{% block body_end %}
    {{ parent() }}
    <script>
        document.addEventListener('submit', function (event) {
            if (event.defaultPrevented) { return; }
            var form = event.target;
            if (!form || form.tagName !== 'FORM') { return; }
            if ((form.getAttribute('method') || 'get').toLowerCase() !== 'post') { return; }
            if (form.getAttribute('target')) { return; }
            if (form.dataset.oswisOdeslano === '1') {
                event.preventDefault();
                return;
            }
            form.dataset.oswisOdeslano = '1';
            window.setTimeout(function () {
                var tlacitka = form.querySelectorAll('button[type="submit"], input[type="submit"]');
                for (var i = 0; i < tlacitka.length; i++) {
                    tlacitka[i].disabled = true;
                }
            }, 0);
        });
    </script>
{% endblock body_end %}

{% block body_header %}
    {% include '@OswisOrgOswisCore/web_admin/header.html.twig' %}
    {# Flash zprávy (chyby/varování/úspěch). Web admin dosud žádné nerenderoval — bez tohoto
       by upozornění z controllerů (např. odmítnutý příliš velký export) byla neviditelná. #}
    {% block admin_flashes %}
        {% for type, messages in app.flashes %}
            {% set cssType = {'danger':'danger','error':'danger','warning':'warning','success':'success','notice':'info','info':'info'}[type]|default('info') %}
            {% for message in messages %}
                <div class="container" style="padding-top:.35rem;">
                    <div class="alert alert-{{ cssType }}" role="alert" style="margin:.35rem 0;">{{ message }}</div>
                </div>
            {% endfor %}
        {% endfor %}
    {% endblock admin_flashes %}
{% endblock body_header %}

{# Drobečková navigace adminu = TÁŽ komponenta jako na webu (web/parts/breadcrumbs.html.twig),
   jen nakrmená admin cestou — žádný vlastní/jiný breadcrumb. Stránka předá `crumbs` =
   [{label, url?}, …] (poslední = aktuální stránka). Bez `crumbs` se odvodí jednoúrovňová cesta
   z titulku (block html_title). Přepisujeme jen bloky komponenty: domovskou položku na admin
   „Úvod", smyčku na admin cestu a poslední (aktivní) položku. #}
{% block body_breadcrumbs %}
    {% if app.request.attributes.get('_route') != 'oswis_org_oswis_core_web_admin_homepage' %}
        {% set crumbList = crumbs|default([]) %}
        {% if crumbList is empty %}
            {% set crumbTitle = block('html_title')|split(' :: ')|first|split(' · ')|first|trim %}
            {% if crumbTitle %}{% set crumbList = [{ 'label': crumbTitle }] %}{% endif %}
        {% endif %}
        {% embed '@OswisOrgOswisCore/web/parts/breadcrumbs.html.twig' %}
            {% block breadcrumb_homapage %}
                {% include '@OswisOrgOswisCore/web/parts/breadcrumb-item.html.twig'
                    with { 'b_url': path('oswis_org_oswis_core_web_admin_homepage'), 'b_title': 'Úvod' } %}
            {% endblock breadcrumb_homapage %}
            {% block breadcrumb_loop %}
                {% for crumb in crumbList %}
                    {% if not loop.last %}
                        {% include '@OswisOrgOswisCore/web/parts/breadcrumb-item.html.twig'
                            with { 'b_url': crumb.url|default(''), 'b_title': crumb.label } %}
                    {% endif %}
                {% endfor %}
            {% endblock breadcrumb_loop %}
            {% block breadcrumb_last %}
                {% if crumbList|length > 0 %}
                    {% include '@OswisOrgOswisCore/web/parts/breadcrumb-item.html.twig'
                        with { 'b_url': '', 'b_title': (crumbList|last).label|default('Tato stránka'), 'b_active': true } %}
                {% endif %}
            {% endblock breadcrumb_last %}
        {% endembed %}
    {% endif %}
{% endblock body_breadcrumbs %}
