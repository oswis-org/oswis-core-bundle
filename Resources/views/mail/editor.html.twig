{#
    Editor textu mailu (spec 2026-09-13 §4) — JEDNA šablona pro „Novou zprávu", hromadný mail
    i formulářové pole MailBodyType. Odesílané pole je <textarea name="{{ name }}">; bez JS (nebo
    než se editor načte) funguje jako kód. Chování dodává Stimulus kontroler `mail-editor` (aplikace).

    Parametry: name, id, value, config (MailEditorConfig::toArray()), required (bool), rows (int),
    label (popisek pro čtečky), preview (nepovinné — náhled vedle textu: {url, recipients: [{id, label}],
    subjectField: id pole předmětu, templateField: id výběru kampaně, document: text je celý Twig dokument
    — neuložená kampaň z obrazovky šablon, parentField: id pole s rodičem „Vychází z", valuesUrl: hodnoty
    údajů příjemce pro dialog „Vložit údaj" — POST s týmž tokenem jako náhled).
#}
{#
    Tlačítko panelu. `toggle` = přepínač se stavem aria-pressed. Příkazy obsluhuje kontroler
    (`mail-editor#command`); pořadí Tabu (jedna zastávka) nastaví kontroler.
#}
{% macro tool(name, label, icon, shortcut = null, toggle = true) %}
    <button type="button" class="btn btn-sm btn-outline-secondary" tabindex="-1"
            data-action="mail-editor#command" data-mail-editor-name-param="{{ name }}"
            aria-label="{{ label }}" title="{{ label }}{{ shortcut ? ' (' ~ shortcut ~ ')' : '' }}"
            {{- toggle ? ' aria-pressed="false"' : '' }}>
        <twig:ux:icon name="{{ icon }}" aria-hidden="true" />
    </button>
{% endmacro %}
{% import _self as t %}
{% set previewConfig = preview|default(null) %}
<div class="mail-editor{{ previewConfig ? ' mail-editor--with-preview' : '' }}" {{ stimulus_controller('mail-editor', {
    config: config,
    label: label|default('Text zprávy'),
    previewUrl: previewConfig ? previewConfig.url : '',
    previewToken: previewConfig ? csrf_token('mail_preview') : '',
    previewSubjectField: previewConfig ? previewConfig.subjectField|default('') : '',
    previewTemplateField: previewConfig ? previewConfig.templateField|default('') : '',
    previewDocument: previewConfig ? previewConfig.document|default(false) : false,
    previewParentField: previewConfig ? previewConfig.parentField|default('') : '',
    previewValuesUrl: previewConfig ? previewConfig.valuesUrl|default('') : '',
    previewAudienceUrl: previewConfig ? previewConfig.audienceUrl|default('') : '',
}) }}>
    <div class="mail-editor__main">
        <div class="mail-editor__toolbar btn-toolbar" role="toolbar" aria-label="Formátování textu"
             aria-controls="{{ id }}-surface" data-mail-editor-target="toolbar">
            <div class="btn-group me-1 mb-1" role="group" aria-label="Písmo">
                {{ t.tool('bold', 'Tučně', 'tabler:bold', 'Ctrl+B') }}
                {{ t.tool('italic', 'Kurzíva', 'tabler:italic', 'Ctrl+I') }}
                {{ t.tool('underline', 'Podtržení', 'tabler:underline', 'Ctrl+U') }}
            </div>
            <div class="btn-group me-1 mb-1" role="group" aria-label="Odstavec">
                {{ t.tool('heading2', 'Nadpis', 'tabler:h-2') }}
                {{ t.tool('heading3', 'Podnadpis', 'tabler:h-3') }}
                {{ t.tool('bulletList', 'Odrážky', 'tabler:list', 'Ctrl+Shift+8') }}
                {{ t.tool('orderedList', 'Číslování', 'tabler:list-numbers', 'Ctrl+Shift+7') }}
            </div>
            <div class="btn-group me-1 mb-1" role="group" aria-label="Zarovnání">
                {{ t.tool('alignLeft', 'Zarovnat vlevo', 'tabler:align-left') }}
                {{ t.tool('alignCenter', 'Zarovnat na střed', 'tabler:align-center') }}
                {{ t.tool('alignJustify', 'Zarovnat do bloku', 'tabler:align-justified') }}
            </div>
            <div class="btn-group me-1 mb-1" role="group" aria-label="Zvýraznění">
                {{ t.tool('warning', 'Upozornění', 'tabler:alert-triangle') }}
                {{ t.tool('highlight', 'Zvýraznění', 'tabler:highlight') }}
                {{ t.tool('small', 'Malé písmo', 'tabler:text-size') }}
            </div>
            <div class="btn-group me-1 mb-1" role="group" aria-label="Vložit">
                {{ t.tool('link', 'Odkaz', 'tabler:link', 'Ctrl+K', false) }}
                {{ t.tool('variable', 'Údaj příjemce', 'tabler:braces', null, false) }}
                {{ t.tool('condition', 'Podmínka', 'tabler:filter', null, false) }}
                {{ t.tool('button', 'Tlačítko', 'tabler:hand-click', null, false) }}
                {{ t.tool('divider', 'Oddělovač', 'tabler:separator', null, false) }}
                {{ t.tool('block', 'Vložený blok', 'tabler:layout-rows', null, false) }}
            </div>
            <div class="btn-group me-1 mb-1" role="group" aria-label="Úpravy">
                {{ t.tool('undo', 'Zpět', 'tabler:arrow-back-up', 'Ctrl+Z', false) }}
                {{ t.tool('redo', 'Znovu', 'tabler:arrow-forward-up', 'Ctrl+Shift+Z', false) }}
            </div>
            <div class="btn-group ms-auto mb-1" role="group" aria-label="Zobrazení">
                {{ t.tool('code', 'Kód', 'tabler:code', null, true) }}
            </div>
        </div>
        <div class="mail-editor__frame">
            <div class="mail-editor__fixed" aria-hidden="true">Ahoj [Oslovení]! (při vykání Dobrý den) — doplní systém</div>
            <div class="mail-editor__surface" id="{{ id }}-surface" data-mail-editor-target="surface"></div>
            <div class="mail-editor__fixed" aria-hidden="true">S pozdravem, Tým Seznamováku… — podpis a patičku doplní systém</div>
        </div>
        <div class="mail-editor__code" data-mail-editor-target="code" hidden>
            <div class="alert alert-danger py-2 mb-2 mail-editor__code-error" role="alert" data-mail-editor-target="codeError" hidden></div>
        </div>
        <textarea class="form-control mail-editor__source" name="{{ name }}" id="{{ id }}" rows="{{ rows|default(14) }}"
                  data-mail-editor-target="source"{{ required|default(false) ? ' required' : '' }}
                  style="font-family: monospace;">{{ value }}</textarea>
        <div class="invalid-feedback mail-editor__required-message">Napiš prosím text zprávy.</div>
        {# `id` uvnitř komponenty stíní prop okna, proto si identifikátor editoru neseme zvlášť. #}
        {% set eid = id %}
        {#
            Dialogy editoru na obecné komponentě `Admin:Modal` (zavřou se křížkem, klepnutím mimo i Esc).
            ⚠️ Editor bývá uvnitř formuláře zprávy: dialog proto NEMÁ vlastní <form> (vnořený formulář
            parser zahodí), tlačítka jsou type="button" a pole bez `name` — nic z dialogu se nesmí odeslat
            s mailem. Obsluha: assets/mail-editor/dialogs.ts (data-dialog-action, data-field).
        #}
        <twig:OswisOrgOswisCore:Admin:Modal id="{{ id }}-dlg-link" title="Odkaz" :fade="false" data-dialog="link">
            <twig:block name="body">
                {% include '@OswisOrgOswisCore/mail/parts/link-target.html.twig' with { eid: eid, prefix: 'link', config: config } only %}
                <div class="mb-2"><label class="form-label" for="{{ eid }}-link-title">Popisek při najetí myší (nepovinné)</label>
                    <input class="form-control" id="{{ eid }}-link-title" data-field="title" type="text" autocomplete="off"></div>
                <div class="text-danger small" data-dialog-error role="alert"></div>
            </twig:block>
            <twig:block name="footer">
                <button type="button" class="btn btn-link me-auto" data-dialog-action="cancel">Zrušit</button>
                <button type="button" class="btn btn-outline-danger" data-dialog-action="remove" data-edit-only hidden>Odebrat odkaz</button>
                <button type="button" class="btn btn-primary" data-dialog-action="apply">Použít</button>
            </twig:block>
        </twig:OswisOrgOswisCore:Admin:Modal>
        <twig:OswisOrgOswisCore:Admin:Modal id="{{ id }}-dlg-variable" title="Vložit údaj příjemce" scrollable :fade="false"
                                            data-dialog="variable" data-title-edit="Změnit údaj příjemce">
            <twig:block name="body">
                <label class="form-label" for="{{ eid }}-variable-search">Hledat</label>
                <input class="form-control mb-2" id="{{ eid }}-variable-search" type="search" data-dialog-search
                       autocomplete="off" data-initial-focus aria-describedby="{{ eid }}-variable-hint">
                {# Ukázka hodnot a počty prázdných dotahuje kontroler (valuesUrl) pro příjemce z náhledu. #}
                <div class="form-text mt-0 mb-1" id="{{ eid }}-variable-hint">Šipkami vybereš, Enterem vložíš.
                    <span data-variable-sample hidden></span></div>
                <div class="mail-editor__dialog-list">
                    {% for group, items in config.variableGroups %}
                        <div role="group" aria-labelledby="{{ eid }}-vg-{{ loop.index }}" data-dialog-group>
                            <div class="mail-editor__dialog-group" id="{{ eid }}-vg-{{ loop.index }}">{{ group }}</div>
                            <div class="list-group">
                                {% for item in items %}
                                    <button type="button" class="list-group-item list-group-item-action mail-editor__variable"
                                            data-dialog-action="insert" data-expression="{{ item.expression }}"
                                            data-search="{{ item.label }} {{ item.chip }} {{ item.expression }}"
                                            title="{{ '{{ ' ~ item.expression ~ ' }}' }}">
                                        <span class="mail-editor__variable-head">
                                            <span class="mail-editor__variable-label">{{ item.label }}</span>
                                            <span class="badge text-bg-light mail-editor__variable-value" data-variable-value hidden></span>
                                        </span>
                                        <small class="mail-editor__variable-warning text-warning-emphasis" data-variable-warning hidden></small>
                                    </button>
                                {% endfor %}
                            </div>
                        </div>
                    {% else %}
                        <p class="small text-muted my-2">Tahle zpráva nemá údaje příjemce k vložení — nevztahuje se k přihlášce. Vlastní výraz jde vložit níže.</p>
                    {% endfor %}
                    <p class="small text-muted my-2" data-dialog-empty hidden>Nic nenalezeno — zkus jiné slovo nebo vlastní výraz.</p>
                </div>
                <details class="mt-2"><summary>Vlastní výraz (pokročilé)</summary>
                    <label class="form-label mt-1" for="{{ eid }}-variable-custom">Výraz Twigu</label>
                    <input class="form-control" id="{{ eid }}-variable-custom" data-field="custom" data-enter="custom" type="text"
                           placeholder="participant.contact.email" autocomplete="off">
                    <button type="button" class="btn btn-sm btn-primary mt-1" data-dialog-action="custom">Vložit výraz</button>
                </details>
                <div class="text-danger small mt-2" data-dialog-error role="alert"></div>
            </twig:block>
            <twig:block name="footer">
                <button type="button" class="btn btn-link me-auto" data-dialog-action="cancel">Zrušit</button>
                <button type="button" class="btn btn-outline-danger" data-dialog-action="remove" data-edit-only hidden>Odebrat údaj</button>
            </twig:block>
        </twig:OswisOrgOswisCore:Admin:Modal>
        {% set hotove %}
            <div class="d-grid gap-1">
                {% for item in config.conditions %}
                    <button type="button" class="btn btn-outline-primary text-start" data-dialog-action="apply"
                            data-cond="{{ item.expression }}" aria-pressed="false" title="{{ '{% if ' ~ item.expression ~ ' %}' }}"
                            {{- loop.first and config.audience|default([]) is empty ? ' data-initial-focus' : '' }}>{{ item.label }}</button>
                {% endfor %}
            </div>
        {% endset %}
        <twig:OswisOrgOswisCore:Admin:Modal id="{{ id }}-dlg-condition" title="Komu se text zobrazí" scrollable :fade="false"
                                            size="{{ config.audience|default([]) is not empty ? 'lg' : '' }}"
                                            data-dialog="condition" data-title-edit="Změnit, komu se text zobrazí">
            <twig:block name="body">
                <p class="small text-muted">Vybrané odstavce uvidí jen příjemci, na které sedí pravidla.</p>
                {% if config.audience|default([]) is not empty %}
                    {# Stavebnice (dávka 2c, bod 7): řádky staví AudienceBuilder (aplikace); uloží se jako
                       {% if pravidla("…") %} — výraz filtru přihlášek. #}
                    <section class="mb-3" data-audience aria-labelledby="{{ eid }}-audience-heading">
                        <h3 class="h6" id="{{ eid }}-audience-heading">Pravidla</h3>
                        <div data-audience-rows></div>
                        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                            <div class="btn-group" role="group" aria-label="Jak pravidla spojit">
                                <button type="button" class="btn btn-sm btn-outline-primary active" data-join="and" aria-pressed="true">a zároveň</button>
                                <button type="button" class="btn btn-sm btn-outline-primary" data-join="or" aria-pressed="false">nebo</button>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-audience-add>
                                <twig:ux:icon name="tabler:plus" aria-hidden="true" /> Přidat pravidlo</button>
                        </div>
                        <div class="alert alert-info py-2 mb-2" data-audience-count role="status" hidden></div>
                        <div class="form-check mb-2" data-audience-else-wrap>
                            <input class="form-check-input" type="checkbox" id="{{ eid }}-audience-else" data-audience-else>
                            <label class="form-check-label" for="{{ eid }}-audience-else">Ostatním zobrazit jiný text
                                <small class="text-muted">(přidá se druhý blok pro ty, na které pravidla nesedí)</small></label>
                        </div>
                        <button type="button" class="btn btn-primary" data-dialog-action="audience">Použít pravidla</button>
                    </section>
                    <details class="mt-2"><summary>Hotové podmínky</summary>{{ hotove }}</details>
                {% else %}
                    {{ hotove }}
                {% endif %}
                <details class="mt-2"><summary>Vlastní podmínka (pokročilé)</summary>
                    <label class="form-label mt-1" for="{{ eid }}-cond-custom">Podmínka Twigu</label>
                    <input class="form-control" id="{{ eid }}-cond-custom" data-field="customCond" data-enter="custom" type="text"
                           placeholder="participant.price > 0" autocomplete="off">
                    <button type="button" class="btn btn-sm btn-primary mt-1" data-dialog-action="custom">Použít vlastní podmínku</button>
                </details>
                <div class="text-danger small mt-2" data-dialog-error role="alert"></div>
            </twig:block>
            <twig:block name="footer">
                <button type="button" class="btn btn-link" data-dialog-action="cancel">Zrušit</button>
            </twig:block>
        </twig:OswisOrgOswisCore:Admin:Modal>
        <twig:OswisOrgOswisCore:Admin:Modal id="{{ id }}-dlg-button" title="Tlačítko" :fade="false" data-dialog="button">
            <twig:block name="body">
                <div class="mb-2"><label class="form-label" for="{{ eid }}-button-text">Text tlačítka</label>
                    <input class="form-control" id="{{ eid }}-button-text" data-field="text" type="text" autocomplete="off" data-initial-focus></div>
                {% include '@OswisOrgOswisCore/mail/parts/link-target.html.twig' with { eid: eid, prefix: 'button', config: config } only %}
                <div class="mb-2"><label class="form-label" for="{{ eid }}-button-title">Popisek při najetí myší (nepovinné)</label>
                    <input class="form-control" id="{{ eid }}-button-title" data-field="title" type="text" autocomplete="off"></div>
                <div class="text-danger small" data-dialog-error role="alert"></div>
            </twig:block>
            <twig:block name="footer">
                <button type="button" class="btn btn-link me-auto" data-dialog-action="cancel">Zrušit</button>
                <button type="button" class="btn btn-primary" data-dialog-action="apply">Použít</button>
            </twig:block>
        </twig:OswisOrgOswisCore:Admin:Modal>
        <twig:OswisOrgOswisCore:Admin:Modal id="{{ id }}-dlg-block" title="Vložený blok" :fade="false" data-dialog="block">
            <twig:block name="body">
                <p class="small text-muted">Obsah bloku doplní systém každému příjemci při odeslání.</p>
                {% for block in config.blocks %}
                    <button type="button" class="btn btn-outline-primary d-block w-100 text-start mb-1" data-dialog-action="insert"
                            data-key="{{ block.key }}"{{ loop.first ? ' data-initial-focus' : '' }}>{{ block.label }}</button>
                {% else %}
                    <p class="small">Žádné bloky nejsou k dispozici.</p>
                {% endfor %}
                <div class="text-danger small mt-2" data-dialog-error role="alert"></div>
            </twig:block>
            <twig:block name="footer">
                <button type="button" class="btn btn-link" data-dialog-action="cancel">Zrušit</button>
            </twig:block>
        </twig:OswisOrgOswisCore:Admin:Modal>
    </div>
    {% if previewConfig %}
        <section class="mail-editor__preview" aria-label="Náhled e-mailu">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <label class="small mb-0" for="{{ id }}-preview-recipient">Náhled pro</label>
                <select class="form-select form-select-sm w-auto mw-100" id="{{ id }}-preview-recipient"
                        data-mail-editor-target="recipient" data-action="mail-editor#refreshPreview">
                    {% for recipient in previewConfig.recipients %}
                        <option value="{{ recipient.id }}">{{ recipient.label }}</option>
                    {% endfor %}
                </select>
                <div class="btn-group btn-group-sm" role="group" aria-label="Šířka náhledu">
                    <button type="button" class="btn btn-outline-primary active" aria-pressed="true"
                            data-action="mail-editor#previewWidth" data-mail-editor-width-param="desktop">
                        <twig:ux:icon name="tabler:device-desktop" aria-hidden="true" /> Počítač</button>
                    <button type="button" class="btn btn-outline-primary" aria-pressed="false"
                            data-action="mail-editor#previewWidth" data-mail-editor-width-param="mobile">
                        <twig:ux:icon name="tabler:device-mobile" aria-hidden="true" /> Mobil</button>
                </div>
                <span class="small text-muted" role="status" data-mail-editor-target="previewStatus"></span>
            </div>
            <div class="small mb-1"><strong>Předmět:</strong> <span data-mail-editor-target="previewSubject">—</span></div>
            <div class="mail-editor__problems" data-mail-editor-target="problems" aria-live="polite"></div>
            <div class="mail-editor__preview-shell" data-mail-editor-target="previewShell">
                {# sandbox: v náhledu neběží skripty ani formuláře; same-origin jen kvůli zachování posunu
                   při obnově, odkazy se otevřou v novém okně (preview.ts vloží <base target="_blank">) #}
                <iframe sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox" title="Náhled e-mailu"
                        data-mail-editor-target="previewFrame"></iframe>
            </div>
        </section>
    {% endif %}
</div>
