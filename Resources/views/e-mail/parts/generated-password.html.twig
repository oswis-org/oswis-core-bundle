{#
    Vygenerované heslo v e-mailu.

    Označené `data-sensitive="password"`, takže odeslaná zpráva heslo obsahuje, ale uložená kopie
    ne ({@see \OswisOrg\OswisCoreBundle\Mail\Secret\MailSecretRedactor}) — jinak by heslo účastníka
    viděl v historii celý tým.

    Parametry: password (heslo), intro (úvodní věta).
#}
<mj-text>{{ intro|default('Bylo nastaveno nové, náhodně vygenerované heslo:') }}</mj-text>
<mj-text font-family="monospace" font-size="16px" background-color="{{ oswis.colors.code_background }}" padding="10px 20px" align="center">
    <span data-sensitive="password">{{ password }}</span>
</mj-text>
